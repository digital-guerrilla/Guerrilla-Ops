      <documents target="true" dimension="spaces"/>
      <validation presenceRule="Space.AtLeastOneRowPresent" stage="Design"/>
      <columns>
        <column name="Name">
          <qa>
            <rule name="NotNull|Unique"/>
          </qa>
          <ui groupTitle="Identification"/>
        </column>
        <column name="CreatedBy">
          <qa>
            <rule name="NotNull"/>
            <format name="email"/>
            <reference targetSheet="Contact" targetColumn="Email" required="true"/>
