        </column>
        <column name="CreatedOn">
          <qa>
            <rule name="NotNull"/>
            <format name="isoDateTime"/>
          </qa>
          <ui groupTitle="Identification"/>
        </column>
        <column name="ExternalSystem">
          <qa>
            <rule name="NotEmpty"/>
          </qa>
          <ui groupTitle="External References"/>
          <runtime aliases="ExtSystem"/>
        </column>
        <column name="ExtObject">
          <qa>
            <rule name="NotEmpty"/>
            <reference targetSheet="Picklist" targetColumn="objFloor" required="true"/>
          </qa>
          <ui groupTitle="External References"/>
          <runtime aliases="ExternalObject|ExtObject"/>
        </column>
        <column name="ExtIdentifier">
          <qa>
            <rule name="NotEmpty"/>
            <format name="GUID"/>
          </qa>
          <ui groupTitle="External References"/>
          <runtime aliases="ExternalIdentifier"/>
        </column>
        <column name="Category">
          <qa>
            <rule name="NotNull"/>
            <reference targetSheet="Picklist" targetColumn="FloorType" required="true"/>
