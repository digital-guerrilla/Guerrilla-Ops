          </qa>
          <ui groupTitle="External References"/>
          <runtime aliases="ExternalIdentifier"/>
        </column>
        <column name="Category">
          <qa>
            <rule name="NotNull"/>
            <reference targetSheet="Picklist" targetColumn="Category-Space" required="true"/>
          </qa>
          <ui groupTitle="Identification"/>
        </column>
        <column name="FloorName">
          <qa>
            <rule name="NotNull"/>
            <reference targetSheet="Floor" targetColumn="Name" required="true">
              <runtime documentContext="true" indexMode="scalar" forwardIndex="spFloor"/>
              <association ownerSheet="Floor" key="spaces" label="Spaces" cardinality="many"/>
              <association ownerSheet="Space" key="floor" label="Floor" cardinality="one"/>
            </reference>
          </qa>
          <ui groupTitle="Identification" label="Floor"/>
          <runtime aliases="Floor Name|Floor"/>
        </column>
        <column name="Description">
          <qa>
            <rule name="NotNull"/>
          </qa>
          <ui groupTitle="Identification"/>
        </column>
        <column name="RoomTag">
          <qa>
            <rule name="NotEmpty"/>
          </qa>
          <ui groupTitle="Identification"/>
          <runtime aliases="Room Tag"/>
        </column>
        <column name="UsableHeight">
          <qa>
            <rule name="ZeroOrGreaterOrNA"/>
          </qa>
          <ui groupTitle="Measurements"/>
        </column>
        <column name="GrossArea">
          <qa>
            <rule name="ZeroOrGreaterOrNA"/>
          </qa>
