      <filter dimension="floor" order="2" contextProperty="floors" throughField="Space" throughIndex="spFloor" emptyLabel="No Floor"/>
      <documents target="true" dimension="floors"/>
      <validation presenceRule="Floor.AtLeastOneRowPresent" stage="Design"/>
      <columns>
        <column name="Name">
          <qa>
            <rule name="NotNull|Unique"/>
          </qa>
          <ui groupTitle="Identification"/>
        </column>
        <column name="CreatedBy">
          <qa>
            <rule name="NotNull"/>
            <format name="email"/>
            <reference targetSheet="Contact" targetColumn="Email" required="true"/>
